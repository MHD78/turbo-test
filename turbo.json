{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "test": { "dependsOn": ["^build"], "outputs": ["apps/web/coverage/**"] },
    "test:coverage": { "dependsOn": ["^build"], "outputs": ["apps/web/coverage/**"] },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "with": ["check-types"],
      "cache": false,
      "persistent": true
    }
    
  }
}
